{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oracle AI Assistant",
  "version": "0.1.0",
  "identifier": "com.oracle.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oracle Chat",
        "width": 400,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": true
      },
      "systemTray": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      }
    }
  }
}
